#: ../../../lib/application/src/claw/application/application.cpp:74
msgid ""
"Level of log informations:\n"
"\t\terror: error messages,\n"
"\t\twarning: warning and error messages,\n"
"\t\tverbose: all messages."
msgstr ""
"ჟურნალში ჩაწერილი ინფორმაციის დონე:\n"
"\t\tშეცდომა: შეცდომის შეტყობინებები,\n"
"\t\tგაფრთხილება: გაფრთხილებისა და შეცდომის შეტყობინებები,\n"
"\t\tდამატებითი შეტყობინებები: ყველა შეტყობინება."

#: ../../../lib/application/src/claw/application/application.cpp:70
msgid "The file to use to store log informations."
msgstr "ფაილი ჟურნალის ინფორმაციის შესანახად."

#: ../../../lib/application/src/claw/application/application.cpp:86
msgid "Use a logger that does not output messages that have been recently output."
msgstr "ჟურნალში ჩაწერის იმ პროგრამის გამოყენება, რომელიც არ გამოიტანს ახლახან გამოტანილ შეტყობინებებს."

#: ../../../lib/application/src/claw/application/application.cpp:81
msgid "Use a logger that does not output successively the same message."
msgstr "ჟურნალში ჩაწერის იმ პროგრამის გამოყენება, რომელიც ერთი და იგივე შეტყობინებებს არ გამოიტანს."

